!/docs/design/A1.2_VISUAL_LOCK.md
!/docs/design/b1-character-provenance.json
!/docs/design/b1/agent-dialog.png
!/docs/design/b1/artifact-report.png
!/docs/design/b1/production-first-screen.png
!/docs/design/references/agent-office-target.png
!/docs/design/references/b20-proposal-v02.txt
!/docs/product/agent-office-product-direction-v0.1/AGENT_OFFICE_PRODUCT_DIRECTION_V0.1.md
!/docs/product/agent-office-product-direction-v0.1/NEW_CHAT_HANDOFF.md
